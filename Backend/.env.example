# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Callback URL registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback

# ── JWT ───────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ── App ───────────────────────────────────────────────────────
FLASK_ENV=development
ADMIN_EMAIL=your-admin-gmail@gmail.com

# ── Supabase / Postgres ───────────────────────────────────────
# Find this in: Supabase Dashboard → Project Settings → Database → Connection string (URI mode)
# Use the Connection Pooler session mode on port 5432
DATABASE_URL=postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Gmail API Notifications (Phase 5) ─────────────────────────
# Run `python generate_gmail_token.py` in the Backend/ folder to get your refresh token
GMAIL_SENDER_EMAIL=your-admin-gmail@gmail.com
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
