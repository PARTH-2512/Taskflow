# ==============================================================================
# TaskFlow Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Flask API on Render / Local)
# ------------------------------------------------------------------------------

# Google Cloud OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth Redirect URI:
# Local dev:      http://localhost:5000/auth/callback
# Production:    https://<your-vercel-app>.vercel.app/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback

# JWT & Flask Secret Key (generate via: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production

# Admin Bootstrap Email (automatically assigned Admin role on first OAuth sign-in)
ADMIN_EMAIL=your-admin-email@gmail.com

# Supabase PostgreSQL Connection URI (Session Pooler mode)
DATABASE_URL=postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Allowed Frontend URL for CORS with credentials
# Local dev:      http://localhost:3000
# Production:    https://<your-vercel-app>.vercel.app
FRONTEND_URL=http://localhost:3000

# Gmail API Credentials for Task Notifications
GMAIL_SENDER_EMAIL=your-sender-email@gmail.com
GMAIL_REFRESH_TOKEN=your-gmail-api-refresh-token

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js on Vercel / Local)
# ------------------------------------------------------------------------------

# Public Backend API Base URL
# Local dev:      http://localhost:5000
# Production:    /api  (proxied via Next.js rewrites in next.config.ts)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Backend URL for Next.js proxy rewrite (Production on Vercel only)
# Required in production so /api/* proxies to your Render Flask backend:
# BACKEND_URL=https://<your-render-service>.onrender.com
